@inject IOptions<OficinaSettings> OficinaOptions

<footer class="site-footer">
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="images/logo.svg" alt="" width="32" height="32" aria-hidden="true" />
                    <strong>@OficinaOptions.Value.NomeCurto</strong>
                </div>
                <p class="small mb-0">@OficinaOptions.Value.Descricao</p>
            </div>
            <div class="col-12 col-md-4">
                <h2 class="h6 mb-2">Contato</h2>
                <ul class="list-unstyled small mb-0">
                    <li>
                        <a href="tel:@TelefoneLimpo" class="footer-link">@OficinaOptions.Value.Telefone</a>
                    </li>
                    <li class="mt-1">
                        <WhatsAppButton Text="WhatsApp" CssClass="btn btn-link btn-sm p-0 footer-link" />
                    </li>
                </ul>
            </div>
            <div class="col-12 col-md-4">
                <h2 class="h6 mb-2">Endereço</h2>
                <address class="small mb-0">
                    @OficinaOptions.Value.Endereco<br />
                    @OficinaOptions.Value.Cidade/@OficinaOptions.Value.Estado — CEP @OficinaOptions.Value.Cep
                </address>
            </div>
        </div>
        <hr class="border-light opacity-25 my-3" />
        <p class="small text-center mb-0">
            &copy; @DateTime.Now.Year @OficinaOptions.Value.Nome. Todos os direitos reservados.
        </p>
    </div>
</footer>

@code {
    private string TelefoneLimpo =>
        new string(OficinaOptions.Value.Telefone.Where(char.IsDigit).ToArray());
}
