@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main-content">
        <header class="app-header px-4 px-lg-5">
            <div>
                <span class="app-header__eyebrow">Oficina Mecânica</span>
                <span class="app-header__title">Gestão da oficina</span>
            </div>

            <span class="app-header__context">Área administrativa</span>
        </header>

        @* O conteúdo das páginas continua sendo renderizado pelo mecanismo padrão de layouts do Blazor. *@
        <article class="content px-4 px-lg-5">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
