@inject IOptions<OficinaSettings> OficinaOptions

<section class="cta-section py-5">
    <div class="container text-center py-lg-3">
        <h2 class="h3 fw-bold mb-3">Precisa de um orçamento?</h2>
        <p class="mb-4 opacity-90 mx-auto" style="max-width: 500px;">
            Entre em contato conosco e receba um atendimento personalizado para o seu veículo.
        </p>
        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
            <a href="/orcamento" class="btn btn-primary btn-lg">Solicitar Orçamento</a>
            <WhatsAppButton Text="Falar pelo WhatsApp" CssClass="btn btn-whatsapp btn-lg" />
        </div>
    </div>
</section>
