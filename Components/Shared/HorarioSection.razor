<section class="py-5 section-alt">
    <div class="container">
        <div class="row align-items-start g-4">
            <div class="col-12 col-md-8">
                <h2 class="section-title mb-4">Horário de Funcionamento</h2>
                <ul class="list-unstyled mb-0">
                    @foreach (var horario in Horarios)
                    {
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="fw-medium">@horario.Dia</span>
                            <span class="@(horario.Periodo == "Fechado" ? "text-muted-custom" : "")">@horario.Periodo</span>
                        </li>
                    }
                </ul>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <span class="badge @StatusBadgeClass fs-6 px-3 py-2" role="status" aria-live="polite">
                    @StatusTexto
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<HorarioItem> Horarios { get; set; } = [];

    private bool EstaAberto => VerificarAberto();

    private string StatusTexto => EstaAberto ? "Aberto agora" : "Fechado agora";

    private string StatusBadgeClass => EstaAberto ? "badge-aberto" : "badge-fechado";

    private bool VerificarAberto()
    {
        var agora = DateTime.Now;
        var diaAtual = (int)agora.DayOfWeek;

        foreach (var horario in Horarios)
        {
            if (string.IsNullOrEmpty(horario.HoraInicio) || string.IsNullOrEmpty(horario.HoraFim))
                continue;

            if (diaAtual >= horario.DiaInicio && diaAtual <= horario.DiaFim)
            {
                if (TimeSpan.TryParse(horario.HoraInicio, out var inicio) &&
                    TimeSpan.TryParse(horario.HoraFim, out var fim))
                {
                    var horaAtual = agora.TimeOfDay;
                    return horaAtual >= inicio && horaAtual <= fim;
                }
            }
        }

        return false;
    }
}
