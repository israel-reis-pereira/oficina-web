@inject IOptions<OficinaSettings> OficinaOptions

<section class="hero-section py-5">
    <div class="container py-lg-4">
        <div class="row align-items-center">
            <div class="col-12 col-lg-8 text-center text-lg-start">
                <h1 class="display-5 fw-bold mb-3">@OficinaOptions.Value.Nome</h1>
                <p class="lead mb-2">@OficinaOptions.Value.Descricao</p>
                <p class="mb-4 opacity-75">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="me-1">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    @OficinaOptions.Value.Cidade/@OficinaOptions.Value.Estado
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                    <a href="/orcamento" class="btn btn-primary btn-lg">Solicitar Orçamento</a>
                    <WhatsAppButton Text="Falar pelo WhatsApp" CssClass="btn btn-whatsapp btn-lg" />
                </div>
            </div>
        </div>
    </div>
</section>
