@page "/financeiro"

<PageTitle>Financeiro | Oficina</PageTitle>

<section class="financeiro-heading d-flex flex-column flex-sm-row align-items-sm-center justify-content-sm-between gap-3 mb-4">
    <div>
        <h1 class="mb-1">Financeiro</h1>
        <p class="text-body-secondary mb-0">Acompanhe entradas, pagamentos e valores pendentes da oficina.</p>
    </div>
    <button type="button" class="btn btn-primary financeiro-primary-action" disabled>+ Novo Lançamento</button>
</section>

<section class="card financeiro-toolbar mb-4" aria-label="Pesquisa e filtro financeiro">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-7">
                <label class="form-label small mb-1" for="pesquisa-financeiro">Pesquisar lançamentos</label>
                <input id="pesquisa-financeiro" class="form-control" type="search" placeholder="Pesquisar por cliente, OS ou lançamento..." disabled />
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label small mb-1" for="filtro-situacao-financeira">Situação</label>
                <select id="filtro-situacao-financeira" class="form-select form-select-sm" disabled>
                    <option>Todas as situações</option>
                    <option>Pendente</option>
                    <option>Pago</option>
                </select>
            </div>
        </div>
    </div>
</section>

<section class="card financeiro-panel" aria-labelledby="lancamentos-financeiros">
    <div class="card-header financeiro-panel__header">
        <div>
            <h2 id="lancamentos-financeiros" class="h5 mb-1">Lançamentos financeiros</h2>
            <p class="text-body-secondary small mb-0">Visualize os valores vinculados aos atendimentos da oficina.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Lançamento</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">OS</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Valor</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lancamento in LancamentosDemonstracao)
                {
                    <tr>
                        <td class="fw-semibold" data-label="Lançamento">@lancamento.Identificacao</td>
                        <td data-label="Cliente">@lancamento.Cliente</td>
                        <td data-label="OS">@lancamento.OrdemServico</td>
                        <td data-label="Tipo">@lancamento.Tipo</td>
                        <td class="fw-semibold" data-label="Valor">@lancamento.Valor</td>
                        <td data-label="Situação"><span class="badge @lancamento.ClasseBadge">@lancamento.Situacao</span></td>
                        <td data-label="Ações">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Ver</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Registrar pagamento</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="alert alert-info financeiro-empty-state mt-4" role="status" hidden>
    <strong>Nenhum lançamento financeiro encontrado.</strong>
    <div class="small mt-1">Novos lançamentos aparecerão aqui quando houver movimentações.</div>
</section>

@code {
    // Dados estáticos usados apenas para validar o wireframe da página nesta fase.
    private static readonly (string Identificacao, string Cliente, string OrdemServico, string Tipo, string Valor, string Situacao, string ClasseBadge)[] LancamentosDemonstracao =
    [
        ("LAN-001", "João da Silva", "OS-001", "Entrada", "R$ 925,00", "Pendente", "text-bg-danger"),
        ("LAN-002", "Maria Oliveira", "OS-002", "Entrada", "R$ 1.200,00", "Pago", "text-bg-success"),
        ("LAN-003", "Carlos Souza", "OS-003", "Pagamento final", "R$ 920,00", "Pago", "text-bg-success")
    ];
}
