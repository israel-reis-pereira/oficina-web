@page "/"
@using Oficina.Web.Models
@using Oficina.Web.Services
@* A página pede resultados prontos ao serviço, sem conhecer os critérios internos de cada consulta. *@
@inject OficinaService OficinaService

<PageTitle>Dashboard | Oficina</PageTitle>

<section class="dashboard-heading mb-4">
    <h1 class="mb-1">Dashboard</h1>
    <p class="text-body-secondary mb-0">Visão geral dos atendimentos e das prioridades da oficina.</p>
</section>

<section class="row g-3 mb-4" aria-label="Indicadores da oficina">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <span class="dashboard-card__label">Veículos em atendimento</span>
                <strong class="dashboard-card__value">@VeiculosEmAtendimento.Count</strong>
                <span class="dashboard-card__detail">Atendimentos ativos</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <span class="dashboard-card__label">Orçamentos pendentes</span>
                <strong class="dashboard-card__value">@OrcamentosPendentes.Count</strong>
                <span class="dashboard-card__detail">Aguardando aprovação</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <span class="dashboard-card__label">Entradas aguardando pagamento</span>
                <strong class="dashboard-card__value">@EntradasAguardandoPagamento.Count</strong>
                <span class="dashboard-card__detail">@FormatarMoeda(ValorTotalEntradas) a receber</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <span class="dashboard-card__label">Serviços em execução</span>
                <strong class="dashboard-card__value">@ServicosEmExecucao.Count</strong>
                <span class="dashboard-card__detail">Em andamento na oficina</span>
            </div>
        </div>
    </div>
</section>

<section class="card dashboard-panel mb-4">
    <div class="card-header dashboard-panel__header">
        <div>
            <h2 class="h5 mb-1">Veículos em atendimento</h2>
            <p class="text-body-secondary small mb-0">Acompanhe o estágio atual de cada serviço.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Placa</th>
                    <th scope="col">Veículo</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var veiculo in VeiculosEmAtendimento)
                {
                    <tr>
                        <td class="fw-semibold" data-label="Placa">@veiculo.Placa</td>
                        <td data-label="Veículo">@veiculo.Descricao</td>
                        <td data-label="Cliente">@veiculo.Cliente</td>
                        <td data-label="Status"><span class="badge @ObterClasseBadge(veiculo.Status)">@ObterDescricaoStatus(veiculo.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section class="card dashboard-panel h-100">
            <div class="card-header dashboard-panel__header">
                <div>
                    <h2 class="h5 mb-1">Orçamentos pendentes</h2>
                    <p class="text-body-secondary small mb-0">Orçamentos que ainda precisam de uma decisão.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Cliente</th>
                            <th scope="col">Veículo</th>
                            <th scope="col">Valor</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var veiculo in OrcamentosPendentes)
                        {
                            <tr>
                                <td data-label="Cliente">@veiculo.Cliente</td>
                                <td data-label="Veículo">@veiculo.Descricao</td>
                                <td class="fw-semibold" data-label="Valor">@FormatarMoeda(veiculo.ValorOrcamento)</td>
                                <td data-label="Status"><span class="badge @ObterClasseBadge(veiculo.Status)">@ObterDescricaoStatus(veiculo.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card dashboard-panel h-100">
            <div class="card-header dashboard-panel__header">
                <div>
                    <h2 class="h5 mb-1">Entradas aguardando pagamento</h2>
                    <p class="text-body-secondary small mb-0">50% necessários antes do pedido das peças.</p>
                </div>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var veiculo in EntradasAguardandoPagamento)
                {
                    <div class="list-group-item px-4 py-3">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <div class="fw-semibold">@veiculo.Cliente</div>
                                <small class="text-body-secondary">@veiculo.Descricao</small>
                            </div>
                            <span class="badge text-bg-danger align-self-start">Pendente</span>
                        </div>
                        <div class="dashboard-entry-values mt-3">
                            <span>Orçamento <strong>@FormatarMoeda(veiculo.ValorOrcamento)</strong></span>
                            <span>Entrada (50%) <strong>@FormatarMoeda(veiculo.ValorOrcamento / 2)</strong></span>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<section class="mt-4" aria-labelledby="alertas-operacionais">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 id="alertas-operacionais" class="h5 mb-0">Alertas operacionais</h2>
        <span class="text-body-secondary small">Prioridades do dia</span>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="alert alert-warning h-100 mb-0" role="alert">
                <strong>Orçamento aguardando aprovação</strong>
                <div class="small mt-1">Mariana Costa — Chevrolet Onix</div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="alert alert-danger h-100 mb-0" role="alert">
                <strong>Entrada de 50% aguardando pagamento</strong>
                <div class="small mt-1">Carlos Mendes — Toyota Corolla</div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="alert alert-info h-100 mb-0" role="alert">
                <strong>Veículo aguardando peças</strong>
                <div class="small mt-1">João da Silva — Honda Civic</div>
            </div>
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<Veiculo> VeiculosEmAtendimento => OficinaService.ObterVeiculosEmAtendimento();
    private IReadOnlyList<Veiculo> OrcamentosPendentes => OficinaService.ObterOrcamentosPendentes();
    private IReadOnlyList<Veiculo> EntradasAguardandoPagamento => OficinaService.ObterEntradasAguardandoPagamento();
    private IReadOnlyList<Veiculo> ServicosEmExecucao => OficinaService.ObterServicosEmExecucao();
    private decimal ValorTotalEntradas => OficinaService.ObterValorTotalEntradas();

    private static string FormatarMoeda(decimal valor) => valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

    private static string ObterDescricaoStatus(StatusServico status) => status switch
    {
        StatusServico.CadastroRealizado => "Cadastro realizado",
        StatusServico.OrcamentoEmAnalise => "Aguardando aprovação",
        StatusServico.AguardandoEntrada => "Aguardando entrada",
        StatusServico.PecasSolicitadas => "Aguardando peças",
        StatusServico.EmExecucao => "Em execução",
        StatusServico.AguardandoPagamento => "Aguardando pagamento",
        StatusServico.Finalizado => "Finalizado",
        _ => throw new ArgumentOutOfRangeException(nameof(status), status, null)
    };

    private static string ObterClasseBadge(StatusServico status) => status switch
    {
        StatusServico.OrcamentoEmAnalise => "text-bg-warning",
        StatusServico.AguardandoEntrada or StatusServico.AguardandoPagamento => "text-bg-danger",
        StatusServico.PecasSolicitadas => "text-bg-info",
        StatusServico.EmExecucao => "text-bg-primary",
        StatusServico.Finalizado => "text-bg-success",
        _ => "text-bg-secondary"
    };
}
