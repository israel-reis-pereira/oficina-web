@page "/"
@inject IOptions<OficinaSettings> OficinaOptions

<PageTitle>@OficinaOptions.Value.Nome — @OficinaOptions.Value.Cidade/@OficinaOptions.Value.Estado</PageTitle>

<HeadContent>
    <meta name="description" content="@OficinaOptions.Value.MetaDescription" />
</HeadContent>

<HeroSection />
<ServicosSection Servicos="OficinaOptions.Value.Servicos" />
<HorarioSection Horarios="OficinaOptions.Value.Horarios" />
<ContatoResumo Titulo="Onde estamos" ShowTelefone="false" ShowReferencia="true" />
<CtaSection />
