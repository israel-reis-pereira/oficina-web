@page "/Error"
@using System.Diagnostics

<PageTitle>Erro</PageTitle>

<h1 class="text-danger">Erro</h1>
<h2 class="text-danger h4">Ocorreu um erro ao processar sua solicitação.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID da requisição:</strong> <code>@RequestId</code>
    </p>
}

<h3 class="h5 mt-4">Modo de desenvolvimento</h3>
<p>
    Ativar o ambiente <strong>Development</strong> exibirá informações mais detalhadas sobre o erro.
</p>
<p>
    <strong>O ambiente de Development não deve ser habilitado em produção.</strong>
    Isso pode expor informações sensíveis aos usuários finais.
    Para depuração local, defina a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    e reinicie a aplicação.
</p>

<p class="mt-4">
    <a href="/" class="btn btn-primary">Voltar ao início</a>
</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
